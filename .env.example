NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Newer Supabase projects may use this instead of SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Comma-separated Supabase Auth emails that receive hidden master-admin access.
MASTER_EMAILS=

# 경영플래너 연동
# 경영플래너 주소 (업무 상세·주간보고에서 여는 링크). 비우면 https://snoopy-planner.vercel.app
NEXT_PUBLIC_PLANNER_URL=
# 실적을 경영플래너와 함께 쓰는 팀 id (기본 park = 파크사업팀)
PLANNER_TEAM_ID=park
