NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Newer Supabase projects may use this instead of SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Comma-separated Supabase Auth emails that receive hidden master-admin access.
MASTER_EMAILS=
# Optional: enables AI summarization of desktop-collected tourism news into a
# top-10 digest. Without it, a plain-text heuristic summary is used instead.
GEMINI_API_KEY=
